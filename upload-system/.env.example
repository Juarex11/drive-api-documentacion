# ==========================================================
# Copia este archivo como ".env" y llena tus valores reales.
# El ".env" NUNCA se sube a git (ya esta en .gitignore).
# ==========================================================

# ---------- SQL Server ----------
DB_SERVER=localhost
DB_DATABASE=UploadSystem
DB_PORT=1433

# Si en SSMS usas "Windows Authentication", deja estas dos vacias
# y pon DB_USE_WINDOWS_AUTH=true
DB_USE_WINDOWS_AUTH=false
DB_USER=sa
DB_PASSWORD=TU_PASSWORD_AQUI

# Si tu SQL Server usa certificado autofirmado (instalacion local tipica)
DB_TRUST_SERVER_CERT=true

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=TU_REFRESH_TOKEN
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# ---------- Drive Labels (opcional, se puede dejar vacio al inicio) ----------
# El ID del label ya creado y publicado por un admin de Workspace
DRIVE_LABEL_ID=
# El ID del campo de seleccion dentro del label
DRIVE_LABEL_FIELD_ID=
# El ID de la opcion seleccionada dentro de ese campo
DRIVE_LABEL_CHOICE_ID=

# ---------- Subida ----------
CHUNK_SIZE_MB=8
UPLOAD_SESSION_MAX_DAYS=7

# ---------- Servidor / Worker ----------
PORT=3000
WORKER_POLL_INTERVAL_MS=3000
